<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manus Clone - AI Agent</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --primary: #06B6D4;
      --primary-dark: #0891B2;
      --secondary: #A855F7;
      --background: #0F172A;
      --card-bg: rgba(15, 23, 42, 0.8);
      --foreground: #F8FAFC;
      --muted: #94A3B8;
      --border: rgba(255, 255, 255, 0.1);
      --glass-bg: rgba(255, 255, 255, 0.05);
    }
    body {
      font-family: 'Outfit', sans-serif;
      background: var(--background);
      color: var(--foreground);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .container { display: flex; height: 100vh; overflow: hidden; }
    .sidebar {
      width: 260px;
      background: rgba(15, 23, 42, 0.95);
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      z-index: 50;
    }
    .sidebar-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border);
      font-weight: 600;
      color: var(--primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sidebar-content {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
    }
    .connector-item {
      background: var(--glass-bg);
      border: 1px solid var(--border);
      padding: 0.75rem;
      border-radius: 0.5rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .connector-item:hover { background: rgba(6, 182, 212, 0.1); border-color: var(--primary); }
    .connector-name { font-weight: 600; margin-bottom: 0.25rem; }
    .connector-type { color: var(--muted); font-size: 0.75rem; }
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: relative;
    }
    .header {
      background: var(--glass-bg);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      padding: 1rem;
      flex-shrink: 0;
    }
    .header-content { max-width: 100%; margin: 0 auto; text-align: center; }
    .header h1 {
      font-size: 2rem;
      font-weight: 700;
      background: linear-gradient(135deg, #06B6D4 0%, #A855F7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.25rem;
    }
    .messages-container { flex: 1; overflow-y: auto; padding: 2rem 1rem; }
    .messages-content { max-width: 100%; margin: 0 auto; display: flex; flex-direction: column; }
    .message { margin-bottom: 1.5rem; display: flex; flex-direction: column; animation: slideIn 0.4s ease-out; }
    .message.user { align-items: flex-end; }
    .message.assistant { align-items: flex-start; }
    .bubble {
      max-width: 85%;
      padding: 1rem 1.25rem;
      border-radius: 1rem;
      font-size: 0.95rem;
      line-height: 1.6;
      word-wrap: break-word;
    }
    .user .bubble {
      background: linear-gradient(to right, #06B6D4, #A855F7);
      color: white;
      border-radius: 1rem 1rem 0 1rem;
    }
    .assistant .bubble {
      background: var(--glass-bg);
      border: 1px solid var(--border);
      border-radius: 1rem 1rem 1rem 0;
    }
    .browser-preview {
      max-width: 85%;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      margin-top: 0.75rem;
      overflow: hidden;
    }
    .browser-preview-header {
      background: rgba(6, 182, 212, 0.1);
      padding: 0.75rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.85rem;
      color: var(--primary);
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .browser-preview-content {
      padding: 1rem;
      max-height: 400px;
      overflow-y: auto;
    }
    .browser-preview-content img {
      width: 100%;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
    }
    .logs-container {
      margin-top: 0.75rem;
      width: 100%;
      max-width: 85%;
      background: rgba(6, 182, 212, 0.05);
      border-right: 3px solid var(--primary);
      padding: 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.85rem;
      color: var(--muted);
    }
    .log-entry { margin-bottom: 0.5rem; }
    .input-container {
      background: var(--glass-bg);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--border);
      padding: 1.25rem;
      flex-shrink: 0;
    }
    .input-content { max-width: 100%; margin: 0 auto; }
    .input-wrapper {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(6, 182, 212, 0.3);
      padding: 0.75rem 1rem;
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .input-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .file-preview {
      display: none;
      align-items: center;
      gap: 0.5rem;
      background: rgba(6, 182, 212, 0.1);
      padding: 0.5rem;
      border-radius: 0.5rem;
      font-size: 0.85rem;
      color: var(--primary);
    }
    .file-preview.active { display: flex; }
    .tool-btn {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 0.5rem;
      border-radius: 0.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .tool-btn:hover { color: var(--primary); border-color: var(--primary); }
    .remove-file { cursor: pointer; color: #ef4444; }
    textarea {
      flex: 1;
      background: transparent;
      color: var(--foreground);
      border: none;
      outline: none;
      font-family: inherit;
      font-size: 1rem;
      resize: none;
    }
    .send-btn {
      background: linear-gradient(to right, #06B6D4, #A855F7);
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 0.75rem;
      cursor: pointer;
      font-weight: 600;
    }
    .send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: 100;
      justify-content: center;
      align-items: center;
    }
    .modal.active { display: flex; }
    .modal-content {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 2rem;
      max-width: 600px;
      width: 90%;
      max-height: 80vh;
      overflow-y: auto;
    }
    .modal-header {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-close { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1.5rem; }
    .connector-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .form-group label { font-weight: 600; color: var(--primary); }
    .form-group input, .form-group textarea {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      padding: 0.75rem;
      border-radius: 0.5rem;
      color: var(--foreground);
      font-family: inherit;
    }
    .form-group input:focus, .form-group textarea:focus {
      outline: none;
      border-color: var(--primary);
      background: rgba(6, 182, 212, 0.1);
    }
    .form-actions {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
    }
    .form-actions button {
      flex: 1;
      padding: 0.75rem;
      border-radius: 0.5rem;
      border: none;
      cursor: pointer;
      font-weight: 600;
    }
    .btn-primary { background: linear-gradient(to right, #06B6D4, #A855F7); color: white; }
    .btn-secondary { background: var(--glass-bg); border: 1px solid var(--border); color: var(--foreground); }
    .hamburger-menu {
      display: none;
      background: none;
      border: none;
      color: var(--primary);
      cursor: pointer;
      font-size: 1.5rem;
      padding: 0.5rem;
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 101;
    }
    .hamburger-menu.active { color: var(--secondary); }
    @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 768px) {
      .container { flex-direction: column; }
      .sidebar {
        width: 100%;
        height: auto;
        max-height: 0;
        overflow: hidden;
        border-left: none;
        border-bottom: 1px solid var(--border);
        transition: max-height 0.3s ease;
        position: relative;
      }
      .sidebar.active {
        max-height: 400px;
        border-bottom: 1px solid var(--border);
      }
      .main-content { height: auto; }
      .hamburger-menu { display: block; }
      .header h1 { font-size: 1.5rem; }
      .header-content { padding-top: 2.5rem; }
      .messages-container { padding: 1rem 0.5rem; }
      .bubble { max-width: 95%; }
      .input-actions {
        flex-wrap: wrap;
      }
      .tool-btn { padding: 0.4rem; }
      .tool-btn svg { width: 18px; height: 18px; }
      textarea { font-size: 16px; }
      .send-btn { padding: 0.4rem 0.8rem; }
      .modal-content { width: 95%; padding: 1.5rem; }
      .browser-preview-content { max-height: 300px; }
    }
    @media (max-width: 480px) {
      .header h1 { font-size: 1.2rem; }
      .header p { font-size: 0.75rem; }
      .messages-container { padding: 0.75rem 0.25rem; }
      .bubble { padding: 0.75rem 1rem; font-size: 0.9rem; }
      .input-wrapper { padding: 0.5rem 0.75rem; gap: 0.5rem; }
      .input-actions { gap: 0.5rem; }
      .tool-btn { padding: 0.35rem; }
      .tool-btn svg { width: 16px; height: 16px; }
      textarea { font-size: 16px; }
      .send-btn { padding: 0.35rem 0.6rem; font-size: 0.9rem; }
      .sidebar-header { padding: 1rem; }
      .sidebar-content { padding: 0.75rem; }
      .connector-item { padding: 0.5rem; font-size: 0.8rem; }
      .modal-header { font-size: 1.2rem; }
      .form-group input, .form-group textarea { padding: 0.5rem; font-size: 16px; }
    }
  </style>
</head>
<body>
  <!-- Hamburger Menu Button -->
  <button class="hamburger-menu" id="hamburgerMenu" title="القائمة">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <div class="container">
    <!-- Sidebar for Connectors -->
    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <span>الموصلات (Connectors)</span>
        <button id="refreshConnectors" style="background:none; border:none; color:var(--primary); cursor:pointer;">↻</button>
      </div>
      <div class="sidebar-content" id="connectorsList">
        <div style="color: var(--muted); font-size: 0.8rem; text-align: center; margin-top: 2rem;">لا توجد موصلات نشطة</div>
      </div>
      <div style="padding: 1rem; border-top: 1px solid var(--border);">
        <button id="addConnectorBtn" class="send-btn" style="width: 100%;">+ إضافة موصل جديد</button>
      </div>
    </div>

    <!-- Main Chat Area -->
    <div class="main-content">
      <div class="header">
        <div class="header-content">
          <h1>Manus Clone</h1>
          <p style="color: var(--muted)">الوكيل الذكي المتطور - تصفح، برمجة، وربط تطبيقات</p>
        </div>
      </div>
      <div class="messages-container" id="chat">
        <div class="messages-content" id="messages">
          <div class="message assistant">
            <div class="bubble">مرحباً! أنا وكيلك الذكي. لقد تم تحديثي الآن بقدرات فائقة:
              <br>🌐 <b>تصفح المواقع:</b> يمكنني زيارة المواقع والتفاعل معها وعرض لقطات الشاشة.
              <br>💻 <b>تعديل الكود:</b> يمكنني قراءة وكتابة الملفات وتنفيذ الأوامر.
              <br>🔌 <b>الموصلات:</b> يمكنني ربط تطبيقاتك الخارجية وإدارتها.
              <br>كيف يمكنني مساعدتك اليوم؟</div>
          </div>
        </div>
      </div>
      <div class="input-container">
        <div class="input-content">
          <div class="input-wrapper">
            <div id="filePreview" class="file-preview">
              <span id="fileName"></span>
              <span class="remove-file" id="removeFile">✕</span>
            </div>
            <div class="input-actions">
              <input type="file" id="fileInput" style="display: none;">
              <button class="tool-btn" id="uploadBtn" title="رفع ملف">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </button>
              <button class="tool-btn" id="connectorsBtn" title="إدارة الموصلات">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><path d="M12 1v6m0 6v6"></path><path d="M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24"></path><path d="M1 12h6m6 0h6"></path><path d="M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"></path></svg>
              </button>
              <textarea id="taskInput" placeholder="اكتب مهمتك هنا (مثلاً: تصفح موقع جوجل، أو عدل ملف server.js)..." rows="1"></textarea>
              <button class="send-btn" id="sendBtn">إرسال</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Connector Modal -->
  <div class="modal" id="connectorModal">
    <div class="modal-content">
      <div class="modal-header">
        <span>إضافة موصل جديد</span>
        <button class="modal-close" id="closeModal">✕</button>
      </div>
      <form class="connector-form" id="connectorForm">
        <div class="form-group">
          <label>اسم الموصل</label>
          <input type="text" id="connectorName" placeholder="مثال: GitHub Integration" required>
        </div>
        <div class="form-group">
          <label>نوع الموصل</label>
          <input type="text" id="connectorType" placeholder="مثال: github, slack, custom_api" required>
        </div>
        <div class="form-group">
          <label>الإعدادات (JSON)</label>
          <textarea id="connectorConfig" placeholder='{"api_key": "your_key", "url": "https://..."}' rows="4" required></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">إضافة الموصل</button>
          <button type="button" class="btn-secondary" id="cancelBtn">إلغاء</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const taskInput = document.getElementById('taskInput');
    const sendBtn = document.getElementById('sendBtn');
    const messagesDiv = document.getElementById('messages');
    const chatContainer = document.getElementById('chat');
    const fileInput = document.getElementById('fileInput');
    const uploadBtn = document.getElementById('uploadBtn');
    const filePreview = document.getElementById('filePreview');
    const fileNameSpan = document.getElementById('fileName');
    const removeFileBtn = document.getElementById('removeFile');
    const connectorsBtn = document.getElementById('connectorsBtn');
    const connectorModal = document.getElementById('connectorModal');
    const closeModal = document.getElementById('closeModal');
    const cancelBtn = document.getElementById('cancelBtn');
    const connectorForm = document.getElementById('connectorForm');
    const addConnectorBtn = document.getElementById('addConnectorBtn');
    const refreshConnectors = document.getElementById('refreshConnectors');
    const hamburgerMenu = document.getElementById('hamburgerMenu');
    const sidebar = document.getElementById('sidebar');

    let currentFileUrl = null;
    let currentFileName = null;

    // وظيفة جلب الموصلات وتحديث القائمة
    async function updateConnectors() {
      try {
        const response = await fetch('/api/connectors');
        const data = await response.json();
        const list = document.getElementById('connectorsList');
        if (data.connectors && data.connectors.length > 0) {
          list.innerHTML = data.connectors.map(c => `
            <div class="connector-item" onclick="selectConnector('${c.id}')">
              <div class="connector-name">${c.name}</div>
              <div class="connector-type">${c.type} • ${c.status === 'enabled' ? 'نشط' : 'معطل'}</div>
            </div>
          `).join('');
        } else {
          list.innerHTML = '<div style="color: var(--muted); font-size: 0.8rem; text-align: center; margin-top: 2rem;">لا توجد موصلات نشطة</div>';
        }
      } catch (e) {
        console.error('فشل جلب الموصلات');
      }
    }

    // فتح/إغلاق نافذة الموصلات
    connectorsBtn.addEventListener('click', () => connectorModal.classList.add('active'));
    addConnectorBtn.addEventListener('click', () => connectorModal.classList.add('active'));
    closeModal.addEventListener('click', () => connectorModal.classList.remove('active'));
    cancelBtn.addEventListener('click', () => connectorModal.classList.remove('active'));
    refreshConnectors.addEventListener('click', updateConnectors);

    // إضافة موصل جديد
    connectorForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('connectorName').value;
      const type = document.getElementById('connectorType').value;
      const config_json = document.getElementById('connectorConfig').value;

      try {
        const response = await fetch('/task/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ task: `أضف موصل جديد باسم "${name}" من نوع "${type}" بالإعدادات: ${config_json}` })
        });
        const data = await response.json();
        if (data.success) {
          connectorForm.reset();
          connectorModal.classList.remove('active');
          updateConnectors();
          alert('تم إضافة الموصل بنجاح!');
        }
      } catch (e) {
        alert('فشل إضافة الموصل');
      }
    });

    // رفع الملفات
    uploadBtn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        uploadBtn.disabled = true;
        const response = await fetch('/upload', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();
        if (data.success) {
          currentFileUrl = data.file_url;
          currentFileName = data.filename;
          fileNameSpan.textContent = currentFileName;
          filePreview.classList.add('active');
        }
      } catch (error) {
        alert('فشل رفع الملف');
      } finally {
        uploadBtn.disabled = false;
      }
    });

    removeFileBtn.addEventListener('click', () => {
      currentFileUrl = null;
      currentFileName = null;
      filePreview.classList.remove('active');
      fileInput.value = '';
    });

    // إرسال المهام
    sendBtn.addEventListener('click', async () => {
      const task = taskInput.value.trim();
      if (!task && !currentFileUrl) return;

      // إضافة رسالة المستخدم
      const userMsg = document.createElement('div');
      userMsg.className = 'message user';
      let userMsgHtml = `<div class="bubble">${task || 'تم رفع ملف'}</div>`;
      if (currentFileUrl) {
        userMsgHtml += `<div style="font-size: 0.8rem; color: var(--muted); margin-top: 0.25rem;">📎 ${currentFileName}</div>`;
      }
      userMsg.innerHTML = userMsgHtml;
      messagesDiv.appendChild(userMsg);
      
      const taskToSend = task;
      const fileUrlToSend = currentFileUrl;
      
      taskInput.value = '';
      currentFileUrl = null;
      currentFileName = null;
      filePreview.classList.remove('active');

      // إضافة رسالة التحميل
      const assistantMsg = document.createElement('div');
      assistantMsg.className = 'message assistant';
      assistantMsg.innerHTML = `<div class="bubble">جاري التفكير وتنفيذ المهمة...</div><div class="logs-container" id="current-logs"></div>`;
      messagesDiv.appendChild(assistantMsg);
      const logsDiv = assistantMsg.querySelector('#current-logs');

      sendBtn.disabled = true;
      chatContainer.scrollTo(0, chatContainer.scrollHeight);

      try {
        const response = await fetch('/task/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ task: taskToSend, file_url: fileUrlToSend })
        });
        const data = await response.json();

        if (data.success) {
          if (data.logs && data.logs.length > 0) {
            logsDiv.innerHTML = data.logs.map(log => `<div class="log-entry">⚡ ${log}</div>`).join('');
          } else {
            logsDiv.style.display = 'none';
          }
          
          // عرض لقطة الشاشة إن وجدت في الرد
          let output = data.output;
          if (output.includes('screenshot') || output.includes('لقطة شاشة')) {
            const browserPreview = document.createElement('div');
            browserPreview.className = 'browser-preview';
            browserPreview.innerHTML = `
              <div class="browser-preview-header">
                📱 معاينة المتصفح
              </div>
              <div class="browser-preview-content">
                <p style="color: var(--muted); font-size: 0.9rem;">${output}</p>
              </div>
            `;
            assistantMsg.appendChild(browserPreview);
          }
          
          assistantMsg.querySelector('.bubble').innerHTML = output.replace(/\n/g, '<br>');
        } else {
          assistantMsg.querySelector('.bubble').textContent = 'عذراً، حدث خطأ أثناء تنفيذ المهمة.';
        }
      } catch (e) {
        assistantMsg.querySelector('.bubble').textContent = 'فشل الاتصال بالخادم.';
      } finally {
        sendBtn.disabled = false;
        chatContainer.scrollTo(0, chatContainer.scrollHeight);
      }
    });

    // منطق الـ Hamburger Menu
    hamburgerMenu.addEventListener('click', () => {
      sidebar.classList.toggle('active');
      hamburgerMenu.classList.toggle('active');
    });

    // إغلاق الـ Sidebar عند النقر على رسالة
    messagesDiv.addEventListener('click', () => {
      sidebar.classList.remove('active');
      hamburgerMenu.classList.remove('active');
    });

    // تحديث الموصلات عند التحميل
    updateConnectors();
  </script>
</body>
</html>
